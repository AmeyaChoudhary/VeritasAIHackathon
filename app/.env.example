# Copy this file to .env.local and fill in the keys you have. .env.local is not committed.
# Without a key, that source's Connect screen says "Not set up yet" and offers sample data.

# Google: one OAuth client ID (Web application) for Gmail, Calendar, Classroom and Drive activity.
VITE_GOOGLE_CLIENT_ID=

# Microsoft 365: an app registration's Application (client) ID, as a single-page app.
VITE_MS_CLIENT_ID=

# Fitbit: a Fitbit app's OAuth 2.0 client ID (type "Client", PKCE). Fitbit turned its Web API
# off on November 2, 2026, so expect this to fail; see app/README.md.
VITE_FITBIT_CLIENT_ID=

# Last.fm API key (free account at https://www.last.fm/api/account/create).
VITE_LASTFM_API_KEY=
