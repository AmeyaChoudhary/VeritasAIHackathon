<?xml version="1.0" encoding="utf-8"?>
<!--
The Steady keyboard's entry in Settings. supportsSwitchingToNextInputMethod lets the globe key
move to the next keyboard.
https://developer.android.com/develop/ui/views/touch-and-input/creating-input-method
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.steady.screentime.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/keyboard_subtype" />
</input-method>
